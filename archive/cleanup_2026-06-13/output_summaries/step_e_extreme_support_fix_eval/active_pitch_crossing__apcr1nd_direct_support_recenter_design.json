{
  "profile_name": "APCR1nD_direct_support_recenter_features",
  "based_on": "APCR1n_recenter_priority_torque_boost",
  "classification": "APCR1N_FEATURES_BLOCKED_BY_UNNECESSARY_APC_DEPENDENCY",
  "date": "2026-06-11",
