  "new_fields": {
    "recenter_priority_direct_enabled": true,
    "recenter_priority_direct_enter_m": 0.08,
    "recenter_priority_direct_emergency_m": 0.12,
    "recenter_priority_direct_hard_m": 0.15,
    "recenter_priority_direct_exit_m": 0.02
  },
  "direct_trigger_conditions": [
    "step >= startup_guard_steps (100)",
    "contact_valid = True",
    "com_z >= 0.27 m",
    "roll <= 0.15 rad",
    "pitch <= 0.15 rad",
    "abs_error > enter_threshold (0.08 m)",
    "moving_away = True"
  ],
  "feature_activation": {
    "feature_1_direct_recenter_priority": "apcr1nd_direct_recenter_priority_active",
    "feature_2_wheel_damping_override": "activates when direct recenter active AND damping fights drift",
    "feature_3_position_cap_boost": "activates when direct recenter active AND safety gates pass"
  },
  "telemetry_columns": [
    "apcr1nd_direct_recenter_priority_active",
    "apcr1nd_direct_recenter_eligible",
    "apcr1nd_direct_recenter_block_reason",
    "apcr1nd_moving_away",
    "apcr1nd_abs_error",
    "apcr1nd_error_rate",
    "apcr1nd_wheel_damping_override_active",
    "apcr1nd_position_cap_boost_active",
    "apcr1nd_position_cap_current",
    "apcr1nd_final_torque_direction_correct",
    "apcr1nd_final_torque_fights_drift"
  ],
  "safety_gates": {
    "contact_valid": "required",
    "com_z_min": 0.27,
    "roll_max_rad": 0.15,
    "pitch_max_rad": 0.15,
    "hard_safety_threshold_m": 0.15
  },
  "thresholds": {
    "enter_m": 0.08,
    "emergency_m": 0.12,
    "hard_m": 0.15,
    "exit_m": 0.02
  },
  "differences_from_apcr1n": {
    "apcr1n_trigger": "_apc_drift_priority_active (requires apc_enabled=True)",
    "apcr1nd_trigger": "direct drift conditions (no APC dependency)",
    "apcr1n_apc_required": true,
    "apcr1nd_apc_required": false
  }
}
