{
  "design_date": "2026-06-09",
  "classification": "APCR1C_BETTER_CENTERING_BUT_LARGER_AMPLITUDE",
  "based_on": "apcr_drift_amplitude_audit.md",

  "problem": {
    "apcr1c_peak_to_peak_500": 0.2398,
    "d2_peak_to_peak_500": 0.1615,
    "increase_pct": 48.5,
    "root_cause": "Constant torque applied until threshold causes momentum-driven overshoot"
  },

  "options_considered": [
    {
      "name": "Option A: Narrower APCR Band",
      "description": "Activate earlier with softer torque",
      "parameters": {
        "outer_enter_m": 0.07,
        "inner_exit_m": 0.065,
        "max_cross_tau": 0.75,
        "opposite_overshoot_m": 0.00
      },
      "pros": ["Softer correction", "Earlier entry"],
      "cons": ["More frequent activation"]
    },
    {
      "name": "Option B: Velocity-Aware Release",
      "description": "Release only when error is approaching zero in correct direction",
      "parameters": {
        "outer_enter_m": 0.08,
        "inner_exit_m": 0.07,
        "release_condition": "error <= 0.08 AND error_rate < 0"
      },
      "pros": ["Prevents releasing during overshoot"],
      "cons": ["Requires error rate telemetry"]
    },
    {
      "name": "Option C: Proportional Torque Shaping",
      "description": "Scale torque inversely with distance from zero",
      "parameters": {
        "outer_enter_m": 0.08,
        "inner_exit_m": 0.07,
        "max_cross_tau": 1.0,
        "torque_mode": "proportional",
        "proportional_band": [0.07, 0.08]
      },
      "pros": ["Smooth transition", "Natural easing", "Addresses root cause"],
      "cons": ["More complex implementation"]
    },
    {
      "name": "Option D: Amplitude-Constrained APCR",
      "description": "Add guard that forces counter-action if error swings too far",
      "parameters": {
        "outer_enter_m": 0.08,
        "inner_exit_m": 0.07,
        "opposite_overshoot_m": -0.05,
        "anti_overshoot_guard": true
      },
      "pros": ["Directly addresses overshoot"],
      "cons": ["Most complex", "May interfere with normal operation"]
    }
  ],

  "recommended_option": "Option C",
  "recommended_name": "APCR1d_proportional_torque",

  "recommended_parameters": {
    "outer_enter_m": 0.08,
    "inner_exit_m": 0.07,
    "max_cross_tau": 1.0,
    "torque_mode": "proportional",
    "proportional_decay": "linear",
    "proportional_formula": "torque = max_cross_tau * (error - inner_exit) / (outer_enter - inner_exit)",
    "opposite_overshoot_m": 0.00,
    "recovery_gate_mode": true,
    "enabled": true
  },

  "expected_outcomes": {
    "peak_to_peak_target": "< 0.20m",
    "max_abs_drift_target": "< 0.170m",
    "positive_pct_target": "< 80%",
    "outside_band_target": "< 10%"
  },

  "validation_plan": [
    "1. 500-step smoke test at low_0p300",
    "2. Compute amplitude metrics (P2P, MaxAbs, min/max)",
    "3. Compare vs APCR1c",
    "4. If improved, proceed to 2000-step",
    "5. If 2000-step improved, proceed to 5000-step"
  ]
}