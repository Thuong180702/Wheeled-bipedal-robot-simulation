      "type": "smoothstep",
      "z_low_m": 0.300,
      "z_high_m": 0.393,
      "activation_at_low": 1.0,
      "activation_at_high": 0.0
    },
    "compensation_formula": "tau_comp = sign * k_support * support_error * height_gate",
    "left_right": "antisymmetric",
    "parameters_tunable": ["k_support", "tau_max", "sign"],
    "implementation_status": "UNIT_TESTS_PASS_INTEGRATION_BUG",
