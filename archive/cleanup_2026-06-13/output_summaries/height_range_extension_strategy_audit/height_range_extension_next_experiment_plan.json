{
  "phase": "Phase 6: Next Experimental Plan",
  "audit_date": "2026-06-06",
  "status": "READY_FOR_EXECUTION",

  "first_experiment": {
    "name": "Baseline_Ladder_Mapping",
    "purpose": "Establish where old controller first fails on height ladder",
    "profile": {
      "sagittal_authority_profile": "candidate_D2_wheel_velocity_damping_light",
      "hy2_div_enabled": false
    },
    "heights_to_test": {
      "low_side": [0.380, 0.360, 0.340, 0.330, 0.320],
      "high_side": [0.430, 0.450, 0.465]
    },
    "step_count": 500,
    "priority": "HIGH"
  },

  "command_template": {
    "low_side": "python scripts/simulate_hierarchical_controller.py --controller-mode balance-core --sagittal-controller velocity-damped --vd-sagittal-authority-profile candidate_D2_wheel_velocity_damping_light --height-variant-setup {setup_file} --steps 500 --telemetry-decimation 1 --output-dir {output_dir}",
    "high_side": "python scripts/simulate_hierarchical_controller.py --controller-mode balance-core --sagittal-controller velocity-damped --vd-sagittal-authority-profile candidate_D2_wheel_velocity_damping_light --height-variant-setup {setup_file} --steps 500 --telemetry-decimation 1 --output-dir {output_dir}"
  },

  "metrics_to_record": [
    "survived_500",
    "contact_valid_pct",
    "height_error_max_m",
    "divergence_RMS",
    "hip_yaw_abs_max",
    "support_max_m",
    "roll_max_rad",
    "wbc_applied",
    "ownership_violations"
  ],

  "500step_gates": {
    "survived": true,
    "contact_valid_pct": 99.5,
    "height_error_m": 0.05,
    "hip_yaw_abs_max_rad": 0.30,
    "roll_max_rad": 0.02,
    "wbc_applied": false,
    "ownership_violations": 0
  },

  "stop_conditions": {
    "immediate_stop": [
      "Contact loss",
      "Height collapse (z < 0.20m)",
      "Roll instability",
      "WBC applied = true",
      "Ownership violations > 0"
    ],
    "continue_with_caution": [
      "Divergence growing but bounded",
      "Support drift increasing",
      "Height error increasing"
    ]
  },

  "decision_points": [
    {
      "question": "Baseline passes at 0.360m?",
      "if_yes": "Continue down ladder",
      "if_no": "Try A0 at 0.360m"
    },
    {
      "question": "Baseline passes at 0.450m?",
      "if_yes": "Continue up ladder",
      "if_no": "Try A0 at 0.450m"
    },
    {
      "question": "A0 helps at 0.300m?",
      "if_yes": "Extend to 0.300m",
      "if_no": "Try A3 or stop"
    },
    {
      "question": "A0 helps at 0.480m?",
      "if_yes": "Extend to 0.480m",
      "if_no": "Try B1 or stop"
    }
  ],

  "setup_files_to_generate": [
    {"height_m": 0.380, "method": "interpolate"},
    {"height_m": 0.340, "method": "interpolate"},
    {"height_m": 0.320, "method": "interpolate"},
    {"height_m": 0.430, "method": "interpolate"},
    {"height_m": 0.465, "method": "interpolate"}
  ],

  "rollback_procedures": {
    "baseline": "Re-run with candidate_D2_wheel_velocity_damping_light profile, no HY2-DIV",
    "hy2_div": "Remove --enable-hip-yaw-divergence-damping flag"
  },

  "frozen_elements": [
    "candidate_D2_wheel_velocity_damping_light profile",
    "Default HY2-DIV disabled",
    "Official Step E/C gates",
    "Baseline 5-variant results"
  ]
}