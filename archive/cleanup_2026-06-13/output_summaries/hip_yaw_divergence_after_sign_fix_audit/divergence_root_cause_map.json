  "root_cause_chain": {
    "primary": {
      "mechanism": "per_joint_pd_inadequate_for_divergence",
      "chain": [
        "1. Per-joint PD computes: tau_L = kp*error_L - kd*vel_L",
        "2. When divergence exists (error_L > 0, error_R < 0):",
        "3. tau_L = kp*(+error) → positive",
        "4. tau_R = kp*(-error) → negative",
        "5. div_torque = (tau_L - tau_R)/2 ≈ kp*error (same sign as divergence)",
        "6. Result: torque ACCELERATES divergence, not DAMP it"
      ],
      "why_per_joint_pd_fails": "Per-joint PD is symmetric: same kp/kd for left and right. When errors are opposite sign, torques are opposite sign, producing pure divergence-mode torque."
    },
    "secondary": {
      "mechanism": "no_divergence_specific_damping",
      "chain": [
        "1. No dedicated antisymmetric torque layer exists",
        "2. HY2-DIV is defined but not enabled",
        "3. Divergence can only be corrected indirectly via per-joint PD",
        "4. Per-joint PD correction happens at wrong mode (common mode)"
      ]
    }
  },
  "fix_priority": [
    {
      "priority": 1,
      "fix": "enable_hy2_div",
      "rationale": "Addresses RC-001 and RC-002. HY2-DIV applies antisymmetric torque that opposes divergence.",
      "conservative_gains": {
        "k_divergence": 5.0,
        "k_divergence_rate": 1.0,
        "tau_max_divergence": 0.5
      },
      "expected_outcome": "Reduce divergence RMS to < 0.10 rad at nominal, < 0.30 rad at low, < 0.25 rad at high"
    },
