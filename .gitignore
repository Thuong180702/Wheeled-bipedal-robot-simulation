# ─── Raw results the manuscripts cite but .gitignore was still masking ───────
# Each path below is named in paper/main.tex, paper/bir/main_v2.tex or the
# "Reproducing the paper" table in README.md, so a reader following the paper
# must be able to fetch it. ~330 kB in total.

# Table 3 — factorial push ablation, N = 30.
!outputs/paper_statistics/ablation_n30_results.json

# Push polar map and the chirality controls (mirror / sham mirror).
!outputs/push_chirality/
outputs/push_chirality/*
!outputs/push_chirality/*.json
!outputs/push_chirality/*.txt

# Oblique curb/ledge regime boundary: the coarse and fine diagonal sweeps.
!outputs/oblique_regime/
outputs/oblique_regime/*
!outputs/oblique_regime/*.txt

# Full-state LQR control experiment.
!outputs/fullstate_lqr_corrected/
outputs/fullstate_lqr_corrected/*
!outputs/fullstate_lqr_corrected/results.json
!outputs/fullstate_lqr_corrected/README.md

# Coupled-model roll-coupling sweep.
!outputs/b_roll_hip_sweep/
outputs/b_roll_hip_sweep/*
!outputs/b_roll_hip_sweep/results_100hz.json

# Actuator-delay cliff at 2 ms resolution, and the single-gain retune that
# moves it outward.
!outputs/robustness_sweep/
outputs/robustness_sweep/*
!outputs/robustness_sweep/*/
!outputs/robustness_sweep/delay_cliff/*.json
!outputs/robustness_sweep/delay_retune/*.json

# Compound disturbance map, as shipped.
!outputs/compound_disturbance/results_corrected_map_shipped.json

# ─── Repo cleanup 2026-08-10 ─────────────────────────────────────────────────
# Untracked with `git rm --cached`; the files remain on disk. The kept set was
# verified by deleting exactly this list on a `git archive HEAD` copy and then
# re-running the paper harnesses (bit-for-bit identical output) and the pytest
# suite (identical result to an untouched copy — zero regressions).
#
# archive/ and assets/robot-urdf/meshes/ are NOT junk: paper harnesses load
# variant-setup JSON from the former at startup, and the MJCF loads the STL
# meshes from the latter. Only the unreferenced remainder is excluded here.

# Fully removed directories.
# PPO checkpoints, except the 5.4M-step snapshot behind the paper's PPO
# reference row. The other five are intermediate steps and a second run; they
# back nothing in the manuscript.
backup_checkpoints/*
!backup_checkpoints/Day2/
backup_checkpoints/Day2/*
!backup_checkpoints/Day2/step_5390336/
docs/repo_cleanup/
docs/superpowers/
.superpowers/
.claude/
paper/Format/
paper/jcd/
paper/archive/

