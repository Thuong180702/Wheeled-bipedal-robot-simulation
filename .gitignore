# =============================================================================
# Wheeled Bipedal Robot Simulation — .gitignore
# =============================================================================

# ─── Python bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.claude/worktrees/

# ─── Build / packaging ───────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST

# ─── Training outputs (checkpoints, logs, telemetry) ─────────────────────────
outputs/
# ...except the raw result files the paper's tables and figures are built from.
# The Code and Data Availability statement in paper/main.tex promises these, so
# they must stay in the repo (~1.5 MB total).
!outputs/
outputs/*
!outputs/acc_ringdown_v3_anchor.json
!outputs/paper_statistics/
outputs/paper_statistics/*
!outputs/paper_statistics/ablation_n10_results.json
!outputs/paper_statistics/ablation_n10_L2_5.json
!outputs/paper_statistics/push_ci_all_ablations.json
!outputs/paper_statistics/robustness_sweep.json
!outputs/paper_statistics/delay_stability_sweep.json
!outputs/paper_statistics/gate_activation_timeseries.json
!outputs/paper_statistics/lqr_baselines_verified.json
!outputs/paper_statistics/acc_lqr_comparison.json
!outputs/paper_verification/
outputs/paper_verification/*
!outputs/paper_verification/idle_ladder.json
!outputs/flight_terrain_n10/
outputs/flight_terrain_n10/*
!outputs/flight_terrain_n10/results.json
!outputs/rate_limit_sweep/
outputs/rate_limit_sweep/*
!outputs/rate_limit_sweep/results.json
!outputs/rate_limit_sweep/results_corrected.json
!outputs/rate_limit_sweep/slew_probe.json
!outputs/compound_disturbance/
outputs/compound_disturbance/*
!outputs/compound_disturbance/results.json
!outputs/compound_disturbance/results_corrected.json

runs/
wandb/
logs/
outputs_residual_smoke/
outputs_residual_test/

# ─── MuJoCo runtime logs ─────────────────────────────────────────────────────
MUJOCO_LOG.TXT
mujoco_log.txt

# ─── Testing & linting caches ────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── OS / editor artifacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── Binary outputs ───────────────────────────────────────────────────────────
*.mp4
*.avi
*.gif

# ─── LaTeX build artifacts ───────────────────────────────────────────────────
*.aux
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.lof
*.lot
*.run.xml
*.bcf
*.synctex.gz
*_backup_*.tex
*_backup_*.pdf
*_backup_*.aux
*_backup_*.log
*_backup_*.synctex.gz

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.log
*.bak
*.tmp

# ─── Repo cleanup 2026-06-13: explicit exclusions ────────────────────────────
# (already matched by *.log above, listed explicitly for clarity)
assets/robot-urdf/export.log
*_run.log

# ─── ROS colcon build log ─────────────────────────────────────────────────────
log/
